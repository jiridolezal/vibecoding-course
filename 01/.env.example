# Copy to .env and adjust. The .env file is git-ignored and must never be committed.

# OpenAI-compatible endpoint. Default is the local LM Studio server.
LLM_BASE_URL=http://localhost:1234/v1

# Model identifier as reported by GET /v1/models.
LLM_MODEL=google/gemma-4-e4b

# LM Studio ignores this value; a real key is only needed for a hosted provider.
LLM_API_KEY=lm-studio

# Safety stop for the tool-calling loop.
LLM_MAX_TOOL_ROUNDS=5
